np:idioma_frances
    a np:Frances, np:Idioma, skos:Concept ;
    rdfs:label "Francés"@es ;
    skos:prefLabel "Francés"@es ;
    owl:sameAs <http://id.loc.gov/vocabulary/languages/fr> .

np:idioma_italiano
    a np:Italiano, np:Idioma, skos:Concept ;
    rdfs:label "Italiano"@es ;
    skos:prefLabel "Italiano"@es ;
    owl:sameAs <http://id.loc.gov/vocabulary/languages/it> .

np:idioma_aleman
    a np:Aleman, np:Idioma, skos:Concept ;
    rdfs:label "Alemán"@es ;
    skos:prefLabel "Alemán"@es ;
    owl:sameAs <http://id.loc.gov/vocabulary/languages/de> .

np:idioma_hungaro
    a np:Hungaro, np:Idioma, skos:Concept ;
    rdfs:label "Húngaro"@es ;
    skos:prefLabel "Húngaro"@es ;
    owl:sameAs <http://id.loc.gov/vocabulary/languages/hu> .

np:idioma_polaco
    a np:Polaco, np:Idioma, skos:Concept ;
    rdfs:label "Polaco"@es ;
    skos:prefLabel "Polaco"@es ;
    owl:sameAs <http://id.loc.gov/vocabulary/languages/pl> .

