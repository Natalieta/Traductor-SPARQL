@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix bf:     <http://id.loc.gov/ontologies/bibframe/> .
@prefix dc:     <http://purl.org/dc/elements/1.1/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix np:     <http://novelas-populares.org/> .

# ================================================================
# ONTOLOGÍA: Grafo de Conocimiento - Novelas Populares
# Estándares: RDF/RDFS/OWL + BIBFRAME + Dublin Core + Schema.org + SKOS
# ================================================================

np:NovelasPopularesOntology
    a owl:Ontology ;
    rdfs:label "Ontología de Novelas Populares"@es ;
    rdfs:comment "Grafo de conocimiento sobre la colección digitalizada de novelas populares"@es ;
    dc:title "Novelas Populares Knowledge Graph"@en ;
    owl:versionInfo "1.0" .

# ── CLASES ──────────────────────────────────────────────────────

np:Novela
    a owl:Class ;
    rdfs:label "Novela"@es ;
    rdfs:comment "Una novela de la colección digitalizada"@es ;
    owl:equivalentClass bf:Text ;
    owl:equivalentClass schema:Book ;
    skos:prefLabel "Novela"@es .

np:Persona
    a owl:Class ;
    rdfs:label "Persona"@es ;
    rdfs:comment "Persona relacionada con la colección"@es ;
    owl:equivalentClass schema:Person ;
    owl:equivalentClass bf:Agent ;
    skos:prefLabel "Persona"@es .

np:Autor
    a owl:Class ;
    rdfs:label "Autor"@es ;
    rdfs:comment "Autor de una novela"@es ;
    rdfs:subClassOf np:Persona ;
    owl:equivalentClass bf:Person ;
    skos:prefLabel "Autor"@es .

np:Editor
    a owl:Class ;
    rdfs:label "Editor"@es ;
    rdfs:comment "Editor o responsable de publicación"@es ;
    rdfs:subClassOf np:Persona ;
    skos:prefLabel "Editor"@es .

np:Genero
    a owl:Class ;
    rdfs:label "Género literario"@es ;
    rdfs:comment "Género o subgénero literario"@es ;
    owl:equivalentClass schema:Genre ;
    skos:prefLabel "Género"@es .

np:Organizacion
    a owl:Class ;
    rdfs:label "Organización"@es ;
    rdfs:comment "Organización relacionada"@es ;
    owl:equivalentClass schema:Organization ;
    owl:equivalentClass bf:Organization ;
    skos:prefLabel "Organización"@es .

np:Editorial
    a owl:Class ;
    rdfs:label "Editorial"@es ;
    rdfs:comment "Casa editorial publicadora"@es ;
    rdfs:subClassOf np:Organizacion ;
    owl:equivalentClass schema:Publisher ;
    skos:prefLabel "Editorial"@es .

np:Lugar
    a owl:Class ;
    rdfs:label "Lugar"@es ;
    rdfs:comment "Lugar geográfico"@es ;
    owl:equivalentClass schema:Place ;
    owl:equivalentClass bf:Place ;
    skos:prefLabel "Lugar"@es .

np:Ciudad
    a owl:Class ;
    rdfs:label "Ciudad"@es ;
    rdfs:comment "Ciudad"@es ;
    rdfs:subClassOf np:Lugar ;
    owl:equivalentClass schema:City ;
    skos:prefLabel "Ciudad"@es .

np:Pais
    a owl:Class ;
    rdfs:label "País"@es ;
    rdfs:comment "País"@es ;
    rdfs:subClassOf np:Lugar ;
    owl:equivalentClass schema:Country ;
    skos:prefLabel "País"@es .

np:Idioma
    a owl:Class ;
    rdfs:label "Idioma"@es ;
    rdfs:comment "Lengua"@es ;
    owl:equivalentClass schema:Language ;
    owl:equivalentClass dct:LinguisticSystem ;
    skos:prefLabel "Idioma"@es .

np:Castellano a owl:Class ; rdfs:subClassOf np:Idioma ; rdfs:label "Castellano"@es ; skos:prefLabel "Castellano"@es .
np:Catalan a owl:Class ; rdfs:subClassOf np:Idioma ; rdfs:label "Catalán"@es ; skos:prefLabel "Catalán"@es .
np:Ingles a owl:Class ; rdfs:subClassOf np:Idioma ; rdfs:label "Inglés"@es ; skos:prefLabel "Inglés"@es .
np:Frances a owl:Class ; rdfs:subClassOf np:Idioma ; rdfs:label "Francés"@es ; skos:prefLabel "Francés"@es .
np:Italiano a owl:Class ; rdfs:subClassOf np:Idioma ; rdfs:label "Italiano"@es ; skos:prefLabel "Italiano"@es .
np:Aleman a owl:Class ; rdfs:subClassOf np:Idioma ; rdfs:label "Alemán"@es ; skos:prefLabel "Alemán"@es .
np:Hungaro a owl:Class ; rdfs:subClassOf np:Idioma ; rdfs:label "Húngaro"@es ; skos:prefLabel "Húngaro"@es .
np:Polaco a owl:Class ; rdfs:subClassOf np:Idioma ; rdfs:label "Polaco"@es ; skos:prefLabel "Polaco"@es .

# ── PROPIEDADES DE OBJETO ────────────────────────────────────────

np:tieneAutor
    a owl:ObjectProperty ;
    rdfs:domain np:Novela ; rdfs:range np:Persona ;
    rdfs:label "tiene autor"@es ;
    owl:equivalentProperty dc:creator ;
    owl:equivalentProperty bf:contribution ;
    owl:equivalentProperty schema:author ;
    skos:definition "Tiene autor"@es .

np:publicadaPor
    a owl:ObjectProperty ;
    rdfs:domain np:Novela ; rdfs:range np:Editorial ;
    rdfs:label "publicada por"@es ;
    owl:equivalentProperty dc:publisher ;
    owl:equivalentProperty schema:publisher ;
    skos:definition "Publicada por"@es .

np:publicadaEnCiudad
    a owl:ObjectProperty ;
    rdfs:domain np:Novela ; rdfs:range np:Ciudad ;
    rdfs:label "publicada en ciudad"@es ;
    owl:equivalentProperty bf:place ;
    skos:definition "Publicada en ciudad"@es .

np:tieneIdiomaEjemplar
    a owl:ObjectProperty ;
    rdfs:domain np:Novela ; rdfs:range np:Idioma ;
    rdfs:label "idioma del ejemplar"@es ;
    owl:equivalentProperty dc:language ;
    owl:equivalentProperty bf:language ;
    skos:definition "Idioma del ejemplar"@es .

np:tieneIdiomaOriginal
    a owl:ObjectProperty ;
    rdfs:domain np:Novela ; rdfs:range np:Idioma ;
    rdfs:label "idioma original"@es ;
    owl:equivalentProperty dct:language ;
    skos:definition "Idioma original"@es .

np:lugarDeNacimiento
    a owl:ObjectProperty ;
    rdfs:domain np:Persona ; rdfs:range np:Ciudad ;
    rdfs:label "lugar de nacimiento"@es ;
    owl:equivalentProperty schema:birthPlace ;
    skos:definition "Lugar de nacimiento"@es .

np:paisDeNacimiento
    a owl:ObjectProperty ;
    rdfs:domain np:Persona ; rdfs:range np:Pais ;
    rdfs:label "país de nacimiento"@es ;
    owl:equivalentProperty schema:birthPlace ;
    skos:definition "País de nacimiento"@es .

np:tieneGenero
    a owl:ObjectProperty ;
    rdfs:domain np:Persona ; rdfs:range np:Genero ;
    rdfs:label "tiene género literario"@es ;
    owl:equivalentProperty schema:genre ;
    skos:definition "Tiene género literario"@es .

np:fundadaEn
    a owl:ObjectProperty ;
    rdfs:domain np:Editorial ; rdfs:range np:Ciudad ;
    rdfs:label "fundada en"@es ;
    owl:equivalentProperty schema:foundingLocation ;
    skos:definition "Fundada en"@es .

np:fundadaPor
    a owl:ObjectProperty ;
    rdfs:domain np:Editorial ; rdfs:range np:Persona ;
    rdfs:label "fundada por"@es ;
    owl:equivalentProperty schema:founder ;
    skos:definition "Fundada por"@es .

np:ubicadaEn
    a owl:ObjectProperty ;
    rdfs:domain np:Ciudad ; rdfs:range np:Pais ;
    rdfs:label "ubicada en"@es ;
    owl:equivalentProperty schema:containedInPlace ;
    skos:definition "Ubicada en"@es .

np:sameAs
    a owl:ObjectProperty ;
    rdfs:domain np:Persona ; rdfs:range owl:Thing ;
    rdfs:label "equivalencia externa"@es ;
    owl:equivalentProperty owl:sameAs ;
    skos:definition "Equivalencia externa"@es .

# ── PROPIEDADES DE DATOS ─────────────────────────────────────────

np:tieneID
    a owl:DatatypeProperty ;
    rdfs:domain np:Novela ; rdfs:range xsd:string ;
    rdfs:label "identificador"@es ;
    owl:equivalentProperty dc:identifier ;
    owl:equivalentProperty bf:identifiedBy ;
    skos:definition "Identificador"@es .

np:tieneURL
    a owl:DatatypeProperty ;
    rdfs:domain np:Novela ; rdfs:range xsd:anyURI ;
    rdfs:label "URL del recurso digital"@es ;
    owl:equivalentProperty schema:url ;
    skos:definition "Url del recurso digital"@es .

np:tieneTitulo
    a owl:DatatypeProperty ;
    rdfs:domain np:Novela ; rdfs:range xsd:string ;
    rdfs:label "título"@es ;
    owl:equivalentProperty dc:title ;
    owl:equivalentProperty bf:title ;
    owl:equivalentProperty schema:name ;
    skos:definition "Título"@es .

np:tieneSubtitulo
    a owl:DatatypeProperty ;
    rdfs:domain np:Novela ; rdfs:range xsd:string ;
    rdfs:label "subtítulo"@es ;
    owl:equivalentProperty bf:subtitle ;
    skos:definition "Subtítulo"@es .

np:anyoPublicacion
    a owl:DatatypeProperty ;
    rdfs:domain np:Novela ; rdfs:range xsd:gYear ;
    rdfs:label "año de publicación"@es ;
    owl:equivalentProperty dc:date ;
    owl:equivalentProperty schema:datePublished ;
    skos:definition "Año de publicación"@es .

np:esTraduccion
    a owl:DatatypeProperty ;
    rdfs:domain np:Novela ; rdfs:range xsd:boolean ;
    rdfs:label "es traducción"@es ;
    skos:definition "Es traducción"@es .

np:fechaNacimiento
    a owl:DatatypeProperty ;
    rdfs:domain np:Persona ; rdfs:range xsd:gYear ;
    rdfs:label "fecha de nacimiento"@es ;
    owl:equivalentProperty schema:birthDate ;
    skos:definition "Fecha de nacimiento"@es .

np:fechaFallecimiento
    a owl:DatatypeProperty ;
    rdfs:domain np:Persona ; rdfs:range xsd:gYear ;
    rdfs:label "fecha de fallecimiento"@es ;
    owl:equivalentProperty schema:deathDate ;
    skos:definition "Fecha de fallecimiento"@es .

np:anyoFundacion
    a owl:DatatypeProperty ;
    rdfs:domain np:Editorial ; rdfs:range xsd:gYear ;
    rdfs:label "año de fundación"@es ;
    owl:equivalentProperty schema:foundingDate ;
    skos:definition "Año de fundación"@es .

np:anyoCierre
    a owl:DatatypeProperty ;
    rdfs:domain np:Editorial ; rdfs:range xsd:gYear ;
    rdfs:label "año de cierre"@es ;
    owl:equivalentProperty schema:dissolutionDate ;
    skos:definition "Año de cierre"@es .

np:informacionRelacionada
    a owl:DatatypeProperty ;
    rdfs:domain np:Editorial ; rdfs:range xsd:string ;
    rdfs:label "información relacionada"@es ;
    skos:definition "Información relacionada"@es .

np:coordenadas
    a owl:DatatypeProperty ;
    rdfs:domain np:Lugar ; rdfs:range xsd:string ;
    rdfs:label "coordenadas geográficas"@es ;
    owl:equivalentProperty schema:geo ;
    skos:definition "Coordenadas geográficas"@es .

np:nombreAutor
    a owl:DatatypeProperty ;
    rdfs:domain np:Persona ; rdfs:range xsd:string ;
    rdfs:label "nombre"@es ;
    owl:equivalentProperty schema:name ;
    owl:equivalentProperty bf:name ;
    skos:definition "Nombre"@es .

np:nombreFundador
    a owl:DatatypeProperty ;
    rdfs:domain np:Persona ; rdfs:range xsd:string ;
    rdfs:label "nombre del fundador"@es ;
    skos:definition "Nombre del fundador"@es .

# ── INSTANCIAS DE IDIOMA ─────────────────────────────────────────

np:idioma_castellano
    a np:Castellano, np:Idioma, skos:Concept ;
    rdfs:label "Castellano"@es ;
    skos:prefLabel "Castellano"@es ;
    owl:sameAs <http://id.loc.gov/vocabulary/languages/es> .

np:idioma_catalan
    a np:Catalan, np:Idioma, skos:Concept ;
